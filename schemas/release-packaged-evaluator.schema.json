{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchboard.local.neutral/schemas/release-packaged-evaluator.schema.json",
  "title": "Synthetic packaged evaluator descriptor",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "kind", "authorization", "version", "lineage", "semantics", "wrappers"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" }, "kind": { "const": "PackagedEvaluatorAssets" },
    "authorization": { "const": "synthetic-only" },
    "version": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
    "lineage": {
      "type": "object", "additionalProperties": false,
      "required": ["candidateVersion", "evaluator", "scoring"],
      "properties": {
        "candidateVersion": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
        "evaluator": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "scoring": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "semantics": { "$ref": "#/$defs/manifest" }, "wrappers": { "$ref": "#/$defs/manifest" }
  },
  "$defs": {
    "manifest": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "$ref": "#/$defs/entry" } },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
