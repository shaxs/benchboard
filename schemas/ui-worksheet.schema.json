{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchboard.local.neutral/schemas/ui-worksheet.schema.json",
  "title": "Baseline-bound local human UI worksheet",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "kind", "reviewId", "reviewer", "reviewedAt", "baselineCompared", "bindings", "baseline", "evidence", "scores", "notes", "improvements"],
  "properties": {
    "schemaVersion": {"type": "string", "pattern": "^1\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
    "kind": {"const": "UIWorksheet"}, "reviewId": {"$ref": "#/$defs/id"},
    "reviewer": {"type": "string", "minLength": 2, "maxLength": 200, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
    "reviewedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "baselineCompared": {"const": true},
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["reportId", "reportDigest", "evaluationId", "bundleDigest", "snapshotId", "treeDigest"],
      "properties": {"reportId": {"$ref": "#/$defs/id"}, "reportDigest": {"$ref": "#/$defs/digest"}, "evaluationId": {"$ref": "#/$defs/id"}, "bundleDigest": {"$ref": "#/$defs/digest"}, "snapshotId": {"$ref": "#/$defs/id"}, "treeDigest": {"$ref": "#/$defs/digest"}}
    },
    "baseline": {
      "type": "object", "additionalProperties": false, "required": ["challengeIdentityDigest", "starterDigest", "workloadDigest"],
      "properties": {"challengeIdentityDigest": {"$ref": "#/$defs/digest"}, "starterDigest": {"$ref": "#/$defs/digest"}, "workloadDigest": {"$ref": "#/$defs/digest"}}
    },
    "evidence": {"type": "array", "minItems": 12, "maxItems": 12, "items": {
      "type": "object", "additionalProperties": false, "required": ["artifactId", "bytes", "sha256", "target", "width", "height", "view"],
      "properties": {"artifactId": {"$ref": "#/$defs/artifactId"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 16777216}, "sha256": {"$ref": "#/$defs/digest"}, "target": {"enum": ["starter", "submission"]}, "width": {"enum": [1440, 1024, 768]}, "height": {"const": 1000}, "view": {"enum": ["board", "drawer"]}}
    }},
    "scores": {
      "type": "object", "additionalProperties": false, "required": ["polish", "hierarchy", "board", "drawer", "feedback", "responsive", "consistency"],
      "properties": {"polish": {"type": "integer", "minimum": 0, "maximum": 5}, "hierarchy": {"type": "integer", "minimum": 0, "maximum": 3}, "board": {"type": "integer", "minimum": 0, "maximum": 3}, "drawer": {"type": "integer", "minimum": 0, "maximum": 3}, "feedback": {"type": "integer", "minimum": 0, "maximum": 2}, "responsive": {"type": "integer", "minimum": 0, "maximum": 2}, "consistency": {"type": "integer", "minimum": 0, "maximum": 2}}
    },
    "notes": {
      "type": "object", "additionalProperties": false, "required": ["polish", "hierarchy", "board", "drawer", "feedback", "responsive", "consistency"],
      "properties": {"polish": {"$ref": "#/$defs/note"}, "hierarchy": {"$ref": "#/$defs/note"}, "board": {"$ref": "#/$defs/note"}, "drawer": {"$ref": "#/$defs/note"}, "feedback": {"$ref": "#/$defs/note"}, "responsive": {"$ref": "#/$defs/note"}, "consistency": {"$ref": "#/$defs/note"}}
    },
    "improvements": {
      "type": "object", "additionalProperties": false,
      "properties": {"polish": {"$ref": "#/$defs/improvement"}, "hierarchy": {"$ref": "#/$defs/improvement"}, "board": {"$ref": "#/$defs/improvement"}, "drawer": {"$ref": "#/$defs/improvement"}, "feedback": {"$ref": "#/$defs/improvement"}, "responsive": {"$ref": "#/$defs/improvement"}, "consistency": {"$ref": "#/$defs/improvement"}}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "artifactId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"}, "note": {"type": "string", "minLength": 3, "maxLength": 8000},
    "improvement": {"type": "object", "additionalProperties": false, "required": ["description", "starterArtifactId", "submissionArtifactId"], "properties": {"description": {"type": "string", "minLength": 12, "maxLength": 8000}, "starterArtifactId": {"$ref": "#/$defs/artifactId"}, "submissionArtifactId": {"$ref": "#/$defs/artifactId"}}}
  }
}
