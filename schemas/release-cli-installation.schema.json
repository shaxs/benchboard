{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic CLI descriptor shape (not authenticity or path approval)",
  "type": "object", "additionalProperties": false,
  "required": ["kind", "schemaVersion", "authorization", "toolingVersion", "challengeVersion", "evaluatorVersion", "packageName", "packageVersion", "assets", "assetsSha256", "workloadDigest", "publicPrdDigest", "visibleDigest", "fixtureDigest"],
  "properties": {
    "kind": { "const": "benchboard.cli.synthetic-installation.v1" },
    "schemaVersion": { "const": "1.0.0" }, "authorization": { "const": "synthetic-only" },
    "toolingVersion": { "$ref": "#/$defs/version" }, "challengeVersion": { "$ref": "#/$defs/version" },
    "evaluatorVersion": { "$ref": "#/$defs/version" },
    "packageName": { "const": "@benchboard/synthetic-tooling" }, "packageVersion": { "const": "0.0.0-synthetic" },
    "assets": { "const": "cli/installed-assets.json" },
    "assetsSha256": { "$ref": "#/$defs/digest" }, "workloadDigest": { "$ref": "#/$defs/digest" },
    "publicPrdDigest": { "$ref": "#/$defs/digest" }, "visibleDigest": { "$ref": "#/$defs/digest" }, "fixtureDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
