{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchboard.local.neutral/schemas/release-profile.schema.json",
  "title": "Explicit release profile, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "profile", "authorization", "entries"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "ReleaseProfile" },
    "profile": { "enum": ["participant", "owner-development", "end-user-tooling", "synthetic"] },
    "authorization": { "enum": ["participant-only", "private-only", "blocked", "synthetic-only"] },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "allOf": [
    { "if": { "properties": { "profile": { "const": "participant" } } }, "then": { "properties": { "authorization": { "const": "participant-only" } } } },
    { "if": { "properties": { "profile": { "const": "owner-development" } } }, "then": { "properties": { "authorization": { "const": "private-only" } } } },
    { "if": { "properties": { "profile": { "const": "end-user-tooling" } } }, "then": { "properties": { "authorization": { "const": "blocked" } } } },
    { "if": { "properties": { "profile": { "const": "synthetic" } } }, "then": { "properties": { "authorization": { "const": "synthetic-only" } } } }
  ],
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "generated": { "enum": ["synthetic-metadata-v1", "tooling-package-v1", "tooling-lock-v1", "installed-assets-v1", "adapter-package-v1"] }
      },
      "oneOf": [
        { "properties": { "source": {} }, "required": ["source"] },
        { "properties": { "generated": {} }, "required": ["generated"] }
      ]
    }
  }
}
