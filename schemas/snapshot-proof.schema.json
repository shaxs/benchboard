{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchboard.local/schemas/snapshot-proof.schema.json",
  "title": "BenchBoard immutable snapshot proof",
  "description": "The one immutable record that states which bytes a freeze published and on what authority. Every domain below is the accepted value the released producer mints: a generic string type appears nowhere a closed identity exists, so a proof that names another module, another policy, another hash algorithm, a differently shaped identity, or a route whose fields do not match that route is rejected by this contract rather than by a consumer's goodwill.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "module",
    "proofId",
    "snapshotId",
    "snapshotContainer",
    "workspaceSubdirectoryName",
    "snapshotRoot",
    "manifestId",
    "runId",
    "frozenSubmissionId",
    "submissionDigest",
    "selectionPolicyId",
    "hashAlgorithmId",
    "hashAlgorithm",
    "freezeRoute",
    "frozenAt",
    "frozenAtProvenance",
    "freezeIntentDigest",
    "treeDigest",
    "fileCount",
    "byteCount",
    "directoryCount",
    "freezeIntentSequence",
    "selectionExclusions",
    "directories",
    "inventory",
    "timeProvenance",
    "freezeAttestation",
    "stopAttestation",
    "stopAssurance"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "instant": {
      "description": "One instant stated as RFC 3339 date-time with an explicit zone. The pattern is the enforcement (an Ajv core build registers no format vocabulary), so a value that is not a full date-time with a zone is rejected here rather than reported by a consumer.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "nullableInstant": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/instant"
        }
      ]
    },
    "absolutePath": {
      "description": "One location stated as a complete path: a drive-qualified Windows path, a mounted POSIX path, or a UNC path. The point of this domain is that a proof names where its bytes actually are, so a relative location or a traversal-shaped location is outside it by construction.",
      "type": "string",
      "minLength": 2,
      "pattern": "^([A-Za-z]:[\\\\/]|/|\\\\\\\\[^\\\\\\\\]+\\\\[^\\\\\\\\/]+)"
    },
    "snapshotIdentity": {
      "type": "string",
      "pattern": "^snap-[0-9a-f]{32}$"
    },
    "submissionIdentity": {
      "type": "string",
      "pattern": "^fsub-[0-9a-f]{32}$"
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "agentStopped",
        "statement",
        "observedAt"
      ],
      "properties": {
        "operator": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "agentStopped": {
          "const": true
        },
        "statement": {
          "type": "string",
          "minLength": 8,
          "maxLength": 2000
        },
        "observedAt": {
          "$ref": "#/$defs/nullableInstant"
        },
        "clockless": {
          "description": "The explicit clockless claim. Only the CLOCKLESS_INITIALIZED route may carry it stated as true; the route conditionals below decide which side of that line a record is on.",
          "type": "boolean"
        }
      }
    },
    "relativeDirectoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\])(?![0-9a-zA-Z]:)[^\\\\/:*?\"<>||]+(/[^\\\\/:*?\"<>||]+)*$"
    },
    "inventoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\])(?![0-9a-zA-Z]:)[^\\\\/:*?\"<>||]+(/[^\\\\/:*?\"<>||]+)*$"
    }
  },
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "benchboard.freeze.snapshot-proof.v1"
    },
    "module": {
      "const": "benchboard-core-freeze-v1"
    },
    "proofId": {
      "type": "string",
      "pattern": "^snap-[0-9a-f]{32}:proof$"
    },
    "snapshotId": {
      "$ref": "#/$defs/snapshotIdentity"
    },
    "snapshotContainer": {
      "$ref": "#/$defs/absolutePath"
    },
    "workspaceSubdirectoryName": {
      "const": "workspace"
    },
    "snapshotRoot": {
      "$ref": "#/$defs/absolutePath"
    },
    "manifestId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "runId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "frozenSubmissionId": {
      "$ref": "#/$defs/submissionIdentity"
    },
    "submissionDigest": {
      "$ref": "#/$defs/sha256"
    },
    "selectionPolicyId": {
      "const": "benchboard-application-snapshot-v1"
    },
    "hashAlgorithmId": {
      "const": "benchboard-sha256-tree-v1"
    },
    "hashAlgorithm": {
      "const": "sha256"
    },
    "freezeRoute": {
      "enum": [
        "STOP_RECORDED",
        "CLOCKLESS_INITIALIZED"
      ]
    },
    "frozenAt": {
      "$ref": "#/$defs/instant"
    },
    "frozenAtProvenance": {
      "enum": [
        "lifecycle.stoppedAt",
        "attestation.observedAt",
        "clock.reading"
      ]
    },
    "freezeIntentDigest": {
      "$ref": "#/$defs/sha256"
    },
    "treeDigest": {
      "$ref": "#/$defs/sha256"
    },
    "fileCount": {
      "type": "integer",
      "minimum": 0
    },
    "byteCount": {
      "type": "integer",
      "minimum": 0
    },
    "directoryCount": {
      "type": "integer",
      "minimum": 0
    },
    "freezeIntentSequence": {
      "type": "integer",
      "minimum": 0
    },
    "selectionExclusions": {
      "const": [
        ".git",
        "node_modules",
        "dist",
        ".agent-teams",
        ".benchboard",
        ".cache",
        "coverage",
        ".vite"
      ]
    },
    "directories": {
      "type": "array",
      "description": "The exact set of directories the published bytes contain, as slash-separated relative paths. A backslash, a drive letter, an absolute lead or an empty segment is not a relative path and is rejected here, so a directory claim can never name a location outside the snapshot.",
      "items": {
        "$ref": "#/$defs/relativeDirectoryPath"
      },
      "uniqueItems": true
    },
    "inventory": {
      "type": "array",
      "description": "The byte inventory of the published snapshot: one entry per regular file, addressed by a slash-separated relative path only. Absolute paths, drive-qualified paths and backslash-separated paths are outside this domain by construction.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/inventoryPath"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "timeProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startedAt",
        "stoppedAt",
        "elapsedMs",
        "clockError",
        "clockWasUnavailable"
      ],
      "properties": {
        "startedAt": {
          "$ref": "#/$defs/nullableInstant"
        },
        "stoppedAt": {
          "$ref": "#/$defs/nullableInstant"
        },
        "elapsedMs": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "clockError": {
          "type": [
            "object",
            "null"
          ]
        },
        "clockWasUnavailable": {
          "type": "boolean"
        }
      }
    },
    "freezeAttestation": {
      "$ref": "#/$defs/attestation"
    },
    "stopAttestation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/attestation"
        }
      ]
    },
    "stopAssurance": {
      "enum": [
        null,
        "operator-attested"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "freezeRoute": {
            "const": "STOP_RECORDED"
          }
        },
        "required": [
          "freezeRoute"
        ]
      },
      "then": {
        "type": "object",
        "description": "The route of a run whose stop was recorded: the stop assurance and a stop attestation are part of the record, the route never carries the clockless claim, and the clock provenance names the recorded instants.",
        "properties": {
          "stopAssurance": {
            "const": "operator-attested"
          },
          "stopAttestation": {
            "type": "object"
          },
          "freezeAttestation": {
            "not": {
              "type": "object",
              "properties": {
                "clockless": {
                  "const": true
                }
              },
              "required": [
                "clockless"
              ]
            }
          },
          "timeProvenance": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "stoppedAt": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "properties": {
                  "clockWasUnavailable": {
                    "const": true
                  }
                },
                "required": [
                  "clockWasUnavailable"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "freezeRoute": {
            "const": "CLOCKLESS_INITIALIZED"
          }
        },
        "required": [
          "freezeRoute"
        ]
      },
      "then": {
        "type": "object",
        "description": "The route of a run that was frozen without ever having been started: no start and no stop value exists, nothing was assured about a stop, and the freeze attestation carries the explicit clockless claim.",
        "properties": {
          "stopAssurance": {
            "const": null
          },
          "stopAttestation": {
            "const": null
          },
          "frozenAtProvenance": {
            "enum": [
              "attestation.observedAt",
              "clock.reading"
            ]
          },
          "freezeAttestation": {
            "type": "object",
            "properties": {
              "clockless": {
                "const": true
              }
            },
            "required": [
              "clockless"
            ]
          },
          "timeProvenance": {
            "type": "object",
            "properties": {
              "startedAt": {
                "const": null
              },
              "stoppedAt": {
                "const": null
              },
              "elapsedMs": {
                "const": null
              },
              "clockError": {
                "const": null
              },
              "clockWasUnavailable": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
